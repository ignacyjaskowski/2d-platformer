{
    "compilerOptions": {
        "outDir": "./dist/",

        "sourceMap": true,

        "module": "commonjs",
        "target": "es5",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    
    "exclude": [ "node_modules" ]
}